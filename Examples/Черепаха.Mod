МОДУЛЬ Черепаха;
ИМПОРТ Ввод, Вывод;

ПОСТОЯННЫЕ
  выс = 15;
  шир = 30;

  (** Направления **)
  вверх  = 0;
  вправо = 1;
  вниз   = 2;
  влево  = 3;

  (** Типы клеток **)
  пусто = 0;

ТИП
  Клетка = ЗАПИСЬ
    тип: ЦЕЛОЕ
  КОНЕЦ;

  Поле = ЗАПИСЬ
    клетки: МАССИВ выс, шир ИЗ Клетка
  КОНЕЦ;

  Точка = ЗАПИСЬ
    x, y: ЦЕЛОЕ
  КОНЕЦ;

  Направление = ЦЕЛОЕ;

  Игра = ЗАПИСЬ
    поле: Поле;
    гдеИгрок: Точка;
    смотрит: Направление
  КОНЕЦ;

ПРОЦЕДУРА СброситьКлетку(ПЕРЕМЕННЫЕ клетка: Клетка);
НАЧАЛО
  клетка.тип := пусто
КОНЕЦ СброситьКлетку;

ПРОЦЕДУРА ЗадатьТочку(ПЕРЕМЕННЫЕ точка: Точка; x, y: ЦЕЛОЕ);
НАЧАЛО
  точка.x := x;
  точка.y := y
КОНЕЦ ЗадатьТочку;

ПРОЦЕДУРА КлеткаВЛитеру(клетка: Клетка): ЛИТЕРА;
ПЕРЕМЕННЫЕ лит: ЛИТЕРА;
НАЧАЛО
  ЕСЛИ клетка.тип = пусто ТОГДА
    лит := '.'
  ИНАЧЕ
    лит := '?'
  КОНЕЦ
ВОЗВРАТ лит КОНЕЦ КлеткаВЛитеру;

ПРОЦЕДУРА НаправлениеВЛитеру(напр: Направление): ЛИТЕРА;
ПЕРЕМЕННЫЕ лит: ЛИТЕРА;
НАЧАЛО
  ЕСЛИ напр = вверх ТОГДА
    лит := '^'
  АЕСЛИ напр = вправо ТОГДА
    лит := '>'
  АЕСЛИ напр = вниз ТОГДА
    лит := 'v'
  АЕСЛИ напр = влево ТОГДА
    лит := '<'
  ИНАЧЕ
    лит := '!'
  КОНЕЦ
ВОЗВРАТ лит КОНЕЦ НаправлениеВЛитеру;

ПРОЦЕДУРА ПоказатьПоле(ПЕРЕМЕННЫЕ поле: Поле; гдеИгрок: Точка; смотрит: Направление);
ПЕРЕМЕННЫЕ x, y: ЦЕЛОЕ;
  лит: ЛИТЕРА;
НАЧАЛО
  Вывод.Перенос;
  ДЛЯ y := 0 ДО выс - 1 ДЕЛАТЬ
    ДЛЯ x := 0 ДО шир - 1 ДЕЛАТЬ
      ЕСЛИ (гдеИгрок.x = x) & (гдеИгрок.y = y) ТОГДА
        лит := НаправлениеВЛитеру(смотрит)
      ИНАЧЕ
        лит := КлеткаВЛитеру(поле.клетки[y, x])
      КОНЕЦ;
      Вывод.Литера(лит)
    КОНЕЦ;
    Вывод.Перенос
  КОНЕЦ;
  Вывод.Перенос
КОНЕЦ ПоказатьПоле;

ПРОЦЕДУРА ОчиститьПоле(ПЕРЕМЕННЫЕ поле: Поле);
ПЕРЕМЕННЫЕ x, y: ЦЕЛОЕ;
НАЧАЛО
  ДЛЯ y := 0 ДО выс - 1 ДЕЛАТЬ
    ДЛЯ x := 0 ДО шир - 1 ДЕЛАТЬ
      СброситьКлетку(поле.клетки[y, x])
    КОНЕЦ
  КОНЕЦ
КОНЕЦ ОчиститьПоле;

ПРОЦЕДУРА ЗапроситьКоманду(ПЕРЕМЕННЫЕ ч: ЦЕЛОЕ);
НАЧАЛО
  Вывод.Строка('0 - выход'); Вывод.Перенос;
  Вывод.Строка(''); Вывод.Перенос;
  Вывод.Строка('Команда: '); Вывод.Опустошить;
  Ввод.Целое(ч)
КОНЕЦ ЗапроситьКоманду;

ПРОЦЕДУРА ВоспринятьКоманду(ПЕРЕМЕННЫЕ выход: БУЛЕВ);
ПЕРЕМЕННЫЕ ч: ЦЕЛОЕ;
НАЧАЛО
  ЗапроситьКоманду(ч);
  ЕСЛИ ч = 0 ТОГДА
    выход := ИСТИНА
  КОНЕЦ
КОНЕЦ ВоспринятьКоманду;

ПРОЦЕДУРА ПодготовитьИгру(ПЕРЕМЕННЫЕ игра: Игра);
НАЧАЛО
  ОчиститьПоле(игра.поле);
  ЗадатьТочку(игра.гдеИгрок, 10, 7);
  игра.смотрт := вверх
КОНЕЦ ПодготовитьИгру;

ПРОЦЕДУРА Играть;
ПЕРЕМЕННЫЕ
  игра: Игра;
  хватит: БУЛЕВ;
НАЧАЛО
  ПодготовитьИгру(игра);
  хватит := ЛОЖЬ;
  ПОВТОР
    ПоказатьПоле(игра.поле, игра.гдеИгрок, игра.смотрит);
    ВоспринятьКоманду(хватит)
  ПОКАНЕ хватит
КОНЕЦ Играть;

ПРОЦЕДУРА Приветствие;
НАЧАЛО
  Вывод.Строка('  =============================='); Вывод.Перенос;
  Вывод.Строка(' | Добро пожаловать в черепаху! |'); Вывод.Перенос;
  Вывод.Строка('  =============================='); Вывод.Перенос;
  Вывод.Перенос
КОНЕЦ Приветствие;

ПРОЦЕДУРА Пуск*;
НАЧАЛО
  Приветствие;
  Играть
КОНЕЦ Пуск;

КОНЕЦ Черепаха.
