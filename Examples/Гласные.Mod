МОДУЛЬ Гласные;

ПРОЦЕДУРА ВВерхнийРегистр(л: ЛИТЕРА): ЛИТЕРА;
НАЧАЛО
  ЕСЛИ ('а' <= л) & (л <= 'я') ТОГДА
    л := ЛИТ(ОРД(л) + (ОРД('Я') - ОРД('я')))
  АЕСЛИ л = 'ё' ТОГДА
    л := 'Ё'
  КОНЕЦ
ВОЗВРАТ л КОНЕЦ ВВерхнийРегистр;

ПРОЦЕДУРА ГласнаяЛи*(л: ЛИТЕРА): БУЛЕВ;
ПЕРЕМЕННЫЕ гласная: БУЛЕВ;
НАЧАЛО
  гласная := ЛОЖЬ;
  л := ВВерхнийРегистр(л);
  ЕСЛИ ('А' <= л) & (л <= 'Я') ИЛИ (л = 'Ё') ТОГДА
    ВЫБОР л ИЗ
      'А', 'Е', 'Ё', 'И', 'О', 'У', 'Ы', 'Э'..'Я': гласная := ИСТИНА
    | 'Б'..'Д', 'Ж'..'З', 'Й'..'Н', 'П'..'Т', 'Ф'..'Ъ', 'Ь':
    КОНЕЦ
  КОНЕЦ
ВОЗВРАТ гласная КОНЕЦ ГласнаяЛи;

ПРОЦЕДУРА Подсчитать*(стр: МАССИВ ИЗ ЛИТЕРА): ЦЕЛОЕ;
ПЕРЕМЕННЫЕ и, кол: ЦЕЛОЕ;
НАЧАЛО
  кол := 0;
  и := 0;
  ПОКА стр[и] # 0X ДЕЛАТЬ
    ЕСЛИ ГласнаяЛи(стр[и]) ТОГДА УВЕЛ(кол) КОНЕЦ;
    УВЕЛ(и)
  КОНЕЦ
ВОЗВРАТ кол КОНЕЦ Подсчитать;


КОНЕЦ Гласные.
