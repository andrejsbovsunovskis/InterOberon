МОДУЛЬ Подсчёт;
ИМПОРТ Ввод, Вывод, Гласные;

ПРОЦЕДУРА Пошёл*;
ПЕРЕМЕННЫЕ
  стр: МАССИВ 100 ИЗ ЛИТЕРА;
  гласных: ЦЕЛОЕ;
НАЧАЛО
  Вывод.Строка('Введите строку:');
  Ввод.Линия(стр);

  гласных := Гласные.Подсчитать(стр);

  Вывод.Строка('В этой строке '); Вывод.Целое(гласных, 0);
  Вывод.Строка(' гласных.'); Вывод.Перенос
КОНЕЦ Пошёл;

КОНЕЦ Подсчёт.
