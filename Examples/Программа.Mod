МОДУЛЬ Программа;
ИМПОРТ Вывод;

ПРОЦЕДУРА ЗаполнитьМассив(ПЕРЕМЕННЫЕ м: МАССИВ ИЗ ЦЕЛОЕ);
ПЕРЕМЕННЫЕ
  и: ЦЕЛОЕ;
НАЧАЛО
  ДЛЯ и := 0 ДО ДЛИНА(м) - 1 ДЕЛАТЬ
    м[и] := и * и
  КОНЕЦ
КОНЕЦ ЗаполнитьМассив;

ПРОЦЕДУРА СчитатьСумму(м: МАССИВ ИЗ ЦЕЛОЕ): ДЛИНЦЕЛОЕ;
ПЕРЕМЕННЫЕ
  и, сумма: ЦЕЛОЕ;
НАЧАЛО
  сумма := 0;
  ДЛЯ и := 0 ДО ДЛИНА(м) - 1 ДЕЛАТЬ
    УВЕЛ(сумма, м[и])
  КОНЕЦ
ВОЗВРАТ сумма КОНЕЦ СчитатьСумму;

ПРОЦЕДУРА ВывестиМассив(м: МАССИВ ИЗ ЦЕЛОЕ);
ПЕРЕМЕННЫЕ и: ЦЕЛОЕ;
НАЧАЛО
  ДЛЯ и := 0 ДО ДЛИНА(м) - 1 ДЕЛАТЬ
    Вывод.Целое(м[и], 3)
  КОНЕЦ;
  Вывод.Перенос
КОНЕЦ ВывестиМассив;

ПРОЦЕДУРА Давай*;
ПЕРЕМЕННЫЕ
  м: МАССИВ 10 ИЗ ЦЕЛОЕ;
  сумма: ДЛИНЦЕЛОЕ;
НАЧАЛО
  ЗаполнитьМассив(м);
  сумма := СчитатьСумму(м);
  Вывод.Строка('Сумма элементов этого массива:'); Вывод.Перенос;
  ВывестиМассив(м);
  Вывод.Строка('равна '); Вывод.Целое(сумма, 0); Вывод.Перенос
КОНЕЦ Давай;

КОНЕЦ Программа.
