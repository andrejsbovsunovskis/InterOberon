MODULE SuiteStrIn;
IMPORT Out, In;
CONST
  greet = 'Hello';
  hex = 41X;
VAR
  s: ARRAY 6 OF CHAR;
  s5: ARRAY 5 OF CHAR;
  s2: ARRAY 6 OF CHAR;
  a4: ARRAY 4 OF CHAR;
  b4: ARRAY 4 OF CHAR;
  ch: CHAR;
  ok: INTEGER;
  c: CHAR;
  n: INTEGER;
  la, lb: ARRAY 64 OF CHAR;
BEGIN
  (* StringTest *)
  s := 'Hello';
  Out.String(s); Out.Ln;
  s := greet;
  Out.String(s); Out.Ln;
  ch := 41X;
  Out.Char(ch); Out.Ln;
  s5 := 41X;
  Out.Char(s5[0]); Out.Ln;
  s := greet;
  IF s = '' THEN ok := 0 ELSE ok := 1 END;
  Out.Int(ok, 0); Out.Ln;
  s := '';
  IF s = '' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  IF 'aa' < 'ab' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  IF 'Hi' = 'Hi' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  IF 'Hi' # 'Ho' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  s := 'Hello';
  IF s = 'Hello' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  IF s # 'World' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  IF s < 'Hi' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  IF s > 'He' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  IF s <= 'Hello' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  IF s >= 'Hello' THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  s2 := 'Hello';
  IF s = s2 THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  s2 := 'World';
  IF s < s2 THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  a4 := 'ABC';
  b4 := 'ABD';
  IF a4 < b4 THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  b4 := 'ABC';
  IF a4 = b4 THEN ok := 1 ELSE ok := 0 END;
  Out.Int(ok, 0); Out.Ln;
  ch := hex;
  Out.Char(ch); Out.Ln;
  Out.Int(ORD(hex), 0); Out.Ln;
  Out.String('Hi'); Out.Ln;
  Out.String(greet); Out.Ln;
  Out.String('Hi'); Out.Ln;
  Out.String('Привет'); Out.Ln;
  Out.Char('Ы'); Out.Ln;

  (* InTest *)
  In.Char(c);
  Out.Int(ORD(c), 0); Out.Ln;
  In.Char(c);
  Out.Int(ORD(c), 0); Out.Ln;
  In.Char(c);
  Out.Int(ORD(c), 0); Out.Ln;
  (* In.Char: 4-byte UTF-8 (U+1F600) -> surrogate pair *)
  In.Char(c);
  Out.Int(ORD(c), 0); Out.Ln;
  In.Char(c);
  Out.Int(ORD(c), 0); Out.Ln;
  In.Int(n);
  Out.Int(n, 0); Out.Ln;
  In.Int(n);
  Out.Int(n, 0); Out.Ln;
  In.Int(n);
  Out.Int(n, 0); Out.Ln;
  In.Int(n);
  Out.Int(n, 0); Out.Ln;
  In.Line(la);
  Out.String(la); Out.Ln;
  In.Line(lb);
  Out.String(lb); Out.Ln;
  In.Line(la);
  Out.Char('['); Out.String(la); Out.Char(']'); Out.Ln;
  In.Line(lb);
  Out.String(lb); Out.Ln;
  In.Line(la);
  Out.String(la); Out.Ln;
  In.Line(la);
  Out.String(la); Out.Ln
END SuiteStrIn.
