МОДУЛЬ OutRu;
(* Smoke: translated Out names from Lib/Out %RU comments. *)
ИМПОРТ Вывод;

ПЕРЕМЕННЫЕ i: ЦЕЛОЕ;
  x: ВЕЩЕСТ;
НАЧАЛО
  Вывод.Открыть;
  Вывод.Строка('--- Литера и Строка ---'); Вывод.Перенос;
  Вывод.Литера('П'); Вывод.Литера('р'); Вывод.Литера('и');
  Вывод.Литера('в'); Вывод.Литера('е'); Вывод.Литера('т');
  Вывод.Литера('!'); Вывод.Перенос;
  Вывод.Строка('Привет, мир!'); Вывод.Перенос;

  Вывод.Строка('--- Целое ---'); Вывод.Перенос;
  i := 0;
  ПОКА i < 5 ДЕЛАТЬ
    Вывод.Целое(i, 3); Вывод.Литера(' '); УВЕЛ(i)
  КОНЕЦ;
  Вывод.Перенос;
  Вывод.Целое(-42, 0); Вывод.Перенос;
  Вывод.Целое(2025, 6); Вывод.Перенос;

  Вывод.Строка('--- Шестн ---'); Вывод.Перенос;
  Вывод.Шестн(255, 0); Вывод.Перенос;
  Вывод.Шестн(255, 4); Вывод.Перенос;

  Вывод.Строка('--- Вещ / ВещФикс / ДлинВещ ---'); Вывод.Перенос;
  x := 1.5;
  Вывод.Вещ(x, 0); Вывод.Перенос;
  Вывод.ВещФикс(x, 0, 2); Вывод.Перенос;
  Вывод.ВещФикс(-x, 0, 3); Вывод.Перенос;
  Вывод.ДлинВещ(0.25, 0); Вывод.Перенос;
  Вывод.ДлинВещФикс(0.25, 0, 4); Вывод.Перенос;

  Вывод.Опустошить
КОНЕЦ OutRu.
