МОДУЛЬ InRu;
ИМПОРТ Ввод, Вывод;

ПЕРЕМЕННЫЕ
  i: ЦЕЛОЕ;
  c: ЛИТЕРА;
  r: ВЕЩЕСТ;
  line: МАССИВ 64 ИЗ ЛИТЕРА;
НАЧАЛО
  Ввод.Открыть;
  Ввод.Литера(c); Вывод.Строка('--- Литера ---'); Вывод.Перенос;
  Вывод.Целое(ОРД(c), 0); Вывод.Перенос;
  Ввод.Целое(i); Вывод.Строка('--- Целое ---'); Вывод.Перенос;
  Вывод.Целое(i, 0); Вывод.Перенос;
  Ввод.Целое(i); Вывод.Целое(i, 0); Вывод.Перенос;
  Ввод.Линия(line);
  Вывод.Строка('--- Линия ---'); Вывод.Перенос;
  Вывод.Строка(line); Вывод.Перенос;
  Ввод.Линия(line); Вывод.Перенос;
  Ввод.Линия(line); Вывод.Строка(line); Вывод.Перенос;
  Ввод.Вещ(r); Вывод.Строка('--- Вещ ---'); Вывод.Перенос;
  Вывод.ВещФикс(r, 0, 1); Вывод.Перенос;
  Вывод.Строка('--- Готово ---'); Вывод.Перенос;
  ЕСЛИ Ввод.Готово ТОГДА Вывод.Строка('да') ИНАЧЕ Вывод.Строка('нет') КОНЕЦ;
  Вывод.Перенос
КОНЕЦ InRu.
